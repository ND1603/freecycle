# Copy this to server/.env and fill in real values.

# Your Neon (or other Postgres) connection string
DATABASE_URL=

# Any long random string, used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# The URL your React dev server runs on, so CORS + cookies work locally
CLIENT_URL=http://localhost:5173

PORT=5000
